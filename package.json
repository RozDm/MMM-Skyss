{
  "name": "mmm-skyss",
  "version": "2.7.0",
  "description": "MagicMirror² module showing realtime public transport departures for the Hordaland/Bergen region (Skyss).",
  "main": "MMM-Skyss.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test --test-reporter=dot test/*.test.js",
    "check": "node scripts/check.js",
    "api": "node scripts/api-sample.js",
    "lint": "eslint .",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:md": "markdownlint-cli2",
    "format": "prettier --write .",
    "format:check": "prettier --check . --log-level warn",
    "typecheck": "tsc -p jsconfig.json",
    "sync-version": "node scripts/sync-version.js",
    "version": "npm run sync-version && git add README.md",
    "prepare": "node scripts/prepare.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RozDm/MMM-Skyss.git"
  },
  "keywords": [
    "MagicMirror",
    "MMM-Skyss",
    "Skyss",
    "Bergen",
    "Hordaland",
    "public-transport"
  ],
  "author": "RozDm (https://github.com/RozDm)",
  "contributors": [
    "Cato Antonsen (https://github.com/CatoAntonsen)"
  ],
  "license": "MIT",
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.css": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{json,yml,yaml}": [
      "prettier --write"
    ],
    "*.md": [
      "markdownlint-cli2 --fix"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "markdownlint-cli2": "^0.24.0",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^7.0.2"
  }
}
