{
  "compilerOptions": {
    "checkJs": true,
    "noEmit": true,
    "target": "ES2021",
    "module": "commonjs",
    "moduleResolution": "node10",
    "ignoreDeprecations": "6.0",
    "maxNodeModuleJsDepth": 0,
    "lib": ["ES2021", "DOM"],
    "types": ["node"],
    "allowJs": true,
    "strict": false,
    "skipLibCheck": true
  },
  "include": ["MMM-Skyss.js", "node_helper.js", "types/**/*.d.ts"],
  "exclude": ["node_modules"]
}
